        }
        lines {
          text: "  <script>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // 1. Liste officielle des 11 jours f\303\251ri\303\251s fran\303\247ais en 2026"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    const JOURS_FERIES_2026 = ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { date: \'2026-01-01\', nom: \"Jour de l\'An\" },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { date: \'2026-04-06\', nom: \'Lundi de P\303\242ques\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { date: \'2026-05-01\', nom: \'F\303\252te du Travail\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { date: \'2026-05-08\', nom: \'Victoire 1945\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { date: \'2026-05-14\', nom: \'Ascension\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { date: \'2026-05-25\', nom: \'Lundi de Pentec\303\264te\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { date: \'2026-07-14\', nom: \'F\303\252te Nationale\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { date: \'2026-08-15\', nom: \'Assomption\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { date: \'2026-11-01\', nom: \'Toussaint\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { date: \'2026-11-11\', nom: \'Armistice 1918\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { date: \'2026-12-25\', nom: \'No\303\253l\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const JOURS_SEMAINE = [\'Dimanche\', \'Lundi\', \'Mardi\', \'Mercredi\', \'Jeudi\', \'Vendredi\', \'Samedi\'];"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    let leaves = JSON.parse(localStorage.getItem(\'joursoff_data\')) || [];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let bridgeLeaveType = \'RTT\'; // Type pos\303\251 par d\303\251faut lors du clic sur \"+ Poser en 1 clic\""
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    let quotas = JSON.parse(localStorage.getItem(\'joursoff_quotas_2026\')) || { cp: 25, rtt: 10 };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let bridgeLeaveType = \'RTT\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    function parseLocal(iso) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const [y, m, d] = iso.split(\'-\').map(Number);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      return new Date(y, m - 1, d);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    function addDaysIso(iso, offset) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const d = parseLocal(iso);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      d.setDate(d.getDate() + offset);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const y = d.getFullYear();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const m = String(d.getMonth() + 1).padStart(2, \'0\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const day = String(d.getDate()).padStart(2, \'0\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      return \\`\\${y}-\\${m}-\\${day}\\`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    function formatShortFr(iso) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      return parseLocal(iso).toLocaleDateString(\'fr-FR\', { day: \'numeric\', month: \'short\' });"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // 2. D\303\251tection automatique des opportunit\303\251s de ponts 2026"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    function detectBridges2026() {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const opportunities = [];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      JOURS_FERIES_2026.forEach(ferie => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const dt = parseLocal(ferie.date);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const dow = dt.getDay(); // 2 = Mardi, 3 = Mercredi, 4 = Jeudi"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        // F\303\251ri\303\251 un JEUDI -> Pont le VENDREDI (1 jour pos\303\251 = 4 jours de repos)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        const dow = dt.getDay();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if (dow === 4) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          const vendredi = addDaysIso(ferie.date, 1);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          const dimanche = addDaysIso(ferie.date, 3);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          opportunities.push({"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            id: \'pont-\' + ferie.date,"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            nomFerie: ferie.nom,"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            dateFerie: ferie.date,"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            nomFerie: ferie.nom,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            jourFerieLabel: \\`Jeudi \\${formatShortFr(ferie.date)}\\`,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            datesAPoser: [vendredi],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            labelAPoser: \\`Vendredi \\${formatShortFr(vendredi)}\\`,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            periodeRepos: \\`Du jeu. \\${formatShortFr(ferie.date)} au dim. \\${formatShortFr(dimanche)}\\`,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            joursPoses: 1,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            joursRepos: 4,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            badge: \'Pont Royal \302\267 4j de repos\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          });"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // F\303\251ri\303\251 un MARDI -> Pont le LUNDI (1 jour pos\303\251 = 4 jours de repos)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        if (dow === 2) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          const samedi = addDaysIso(ferie.date, -3);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          const lundi = addDaysIso(ferie.date, -1);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          opportunities.push({"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            id: \'pont-\' + ferie.date,"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            nomFerie: ferie.nom,"
