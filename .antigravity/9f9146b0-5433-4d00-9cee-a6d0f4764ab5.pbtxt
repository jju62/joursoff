    thinking_signature: "\022\271\017\n\266\017\001i\024}\0233\031v\261\361[\227\233\262!\244U\vtf\003\020\006\200\270\375\3550\003Z\330Rk\304\311\303\353\022l\326\276\fS\254\215`[\242\003\207\264\356\200\211\254\225:\000\347\003\225G|\3437\227;\270:\236-4{s\322(bN\266\366\016\352J\255\364?\000u\234/l\177\311\027\242\030\036\264=s\035\035\344\314\314\360\226\242b$J\260\221\\$R~\363\205\026\346Y\227\313\345\214\270B\276+\027\326\275\004e\026s\276\344*\302\342\310\245j\020og\241\021\206GH\246\204\n$\235\003\216\375\242\341\375dGRM\237\000\304q\244\233\351\023mmUN~\367\245\226rE\036\\z\3561x[\247 \001\245\266pOc\331~|T\"\256\235\322\341\ft\266\313X\315\246\021q\306\027\v\273\253\230\205M\275O\022P\177\224\371\004\211\agAw\005\036\006\206D\"I\263\346\213\245\250;G\r\330\235\267\255\362\304M\2208~M\to\v\307gd\355TOK\354\210}K\344\226\231Q\r\265^\202\320A/\201\376Bx\264\\F*E\030\353U\222Nn,\002\311\371\365|+[\330y\206\231#\337G\240\214\325\351\001N\266\323\335{\340\200\026\233\262r>r\315\245\377\366\225\227\304\223\f\363(\273\253{\371\251k\213\370\356\267\372\353\346j\323\233\205\374\035\346p\252\220\212\220\364u\326l#cd\256\037 p\215a\216\3022\300H\\\002\256\262\024\177JX\v[\363~\225\330<\224\271~\'\265G\363Th\276\342\324\327{\305\307\376~\201\037Pkt\344\334\311|\035\2606L\320X\035\250\210\217X7\331\277+\370\255\360\347\016\241\351\216\2461\2711\314\024\347\221\304J\237\0366/s\200\373\316\254\315@\342\340\314R\365\035Y\222\b\242h\017\223tj\362\221`\275\002\032\3264i\306\312=\241\216\211\200\255+\270S\314\331\255\334\002$\212P\356\275YRa\020\003\363\335!F\374e\360\302\342k\222\366\213\350\377\251\261)\306wn\262\257\240\210\320\216\362X+\276h\f\310\266H?\206\202pb\200\362\301f\020\270\200\372E\211\3045\034\362*\334\'\034\277\322W^\353N_\375\"\030\244\234`\260bR\3001v\313I5\035}Ph\351\360b\360\003\330\216K\361p?\230\344A@-\377\375H\365\b3R9\343\241-\302%\213\313\305\214\276v\245*y\232\377\271\246\223(wZJ\252\257\377\323;\263\231\277\367\365Bz}\2138\247\211\022\300\277\340\356\277M[\237\250/\033\263\306\244\016\003\f\340\000\371\035\356\'z\247\275\004\341Z\031\032\201F\327\221\025r\351\251\237\322v\005\304:\245\004;\3424\350\312/\2438\300\363~\241\315\230\341\373\316\251\312\375\222\021\311\227\301\313\264\244\367\372\223\2139-\206\254\216\216\032\363\341\217oJ\232\255U/6\333=\006ov\266(L\340\361s\000\251\262\245I>\317\315\177\3017\220+\316\205\0354>/K=\252\362\345aN$\300#O\223\302;\2608v\273)S\311y\213G\"\034O9\001\204\224(;\341!4>\006\224\255\252\036L;\225=\233\332l\027\263s\337uQ\203\252\211\215\334&d\036>1\321f\365\301\210\214\357\372\033\227\371\341\365%\020Z\343\272\t8\252\362\017\206\301\306_\316\245G$k\353\241\243Q\224Sd|\241\246\246\177\226\022\347\021q\261X\227\375\356rl\n\344\303\255w\352 $7\3145\356e\a\032\364\362\270\321\036\005\027\352\222\216\214\205\n\251\344\357}P:]\3734\250\347\v\'\"\362\220\032\321s\227\037\032\020G\315 \366\222\256\315\177Yu\264\r\017n\006!\371M<I&\035\304&\365O%Y\277\036*&\n\f\263 \300\341\036A\235\332\203\355@\026^\234\216j\b\034T\354W\320\347/\321\265\303\361\347VP\021\232\377\220\217\242v0<\001\033\201\220\370\277\313\374\343\371\251s\177\374\352C\251\0232\032\371\2471\225\322\346\247\265\231b\236\212p\020\356~[\362\202\207\353\'\260\320z\214<\267!\0304\315d\203\245z\325\002\351@\366\210\273\363\bs\257\370\263%\264\322\243~@V\330v\205\357\372\347EDWV`}TPTT/\200\215V.\242\245}l\205\034\260\253\332\357\234,$t\352 \364\214\032\\\224lON\255\371z\205O>\222\3032Y+\005G\247\227E$\300\375\v\311\224\320\365;\v\221\327\207\000HH\n\214\006\351[\330~\246&\201+\n\035\001\350\360\214e\1778\347k\267\352Wsi\221x\000\255\340\224\272\351N\217a\374\350\2531\333Q\0358\n\'\207\312?\352;\331\3072\362)\326 \327\264{y\2668\352\377\302a\211\254es\240\367\352{/IFP\226\357\372\363|(\377\355\262\321sG\351a\335\252\212_\3472\v\367\323\237\353\v\344\346\203\303@)\322\313l\a5)V$g[\232\016\017`O{\376\004\200\211\210\001\a\bT\v\"/\376n\351V\313\224K.\373\256ZY<K\342\310\236\364\346\002\305\206\203\021\246\276\005\360\322Fep\237