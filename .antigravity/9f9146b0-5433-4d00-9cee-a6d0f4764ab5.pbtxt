    content: "                        </button>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            </section>\n\n            {/* Section : Analyse compl\303\250te des 11 jours f\303\251ri\303\251s fran\303\247ais 2026 */}\n            <section id=\"calendrier\" className=\"bg-white rounded-2xl border border-slate-200/80 p-5\">\n              <div className=\"flex items-center justify-between mb-4\">\n                <div>\n                  <h2 className=\"text-sm font-extrabold text-slate-900 flex items-center gap-2\">\n                    <Calendar className=\"w-4 h-4 text-indigo-600\" />\n                    Calendrier officiel des 11 jours f\303\251ri\303\251s 2026\n                  </h2>\n                  <p className=\"text-xs text-slate-500 mt-0.5\">\n                    Diagnostic automatique des ponts et week-ends prolong\303\251s en France\n                  </p>\n                </div>\n              </div>\n\n              <div className=\"divide-y divide-slate-100\">\n                {holidaySummary.map((h) => (\n                  <div\n                    key={h.date}\n                    className=\"py-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-xs\"\n                  >\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"font-bold text-slate-900\">{h.name}</span>\n                      <span className=\"text-slate-300\" aria-hidden=\"true\">\n                        \302\267\n                      </span>\n                      <span className=\"text-slate-600 font-mono-tabular\">\n                        {h.dayFull} {h.formattedDate} 2026\n                      </span>\n                    </div>\n                    <div className=\"flex items-center gap-2\">\n                      <span\n                        className={`font-semibold ${\n                          h.status === \'pont_mardi_jeudi\'"
    raw_content: "import React, { useState, useEffect, useMemo, useCallback } from \'react\';\nimport {\n  Plus,\n  Sparkles,\n  Trash2,\n  Check,\n  Copy,\n  Download,\n  Code2,\n  Calendar,\n  Zap,\n  X,\n  Smartphone,\n  RotateCcw,\n  ArrowRight,\n  Pencil,\n  SlidersHorizontal,\n  User,\n  LogOut,\n  Cloud,\n  CloudCheck,\n  Loader2,\n} from \'lucide-react\';\nimport type { User as SupabaseUser } from \'@supabase/supabase-js\';\nimport {\n  FRENCH_HOLIDAYS_2026,\n  analyzeBridges2026,\n  getHolidayCalendarSummary2026,\n  formatShortDateFr,\n  BridgeOpportunity,\n} from \'./holidays2026\';\nimport { STANDALONE_HTML_CODE } from \'./standaloneHtml\';\nimport { usePWAInstall } from \'./usePWAInstall\';\nimport { supabase } from \'./supabase\';\nimport { fetchUserSettings, saveUserSettings } from \'./syncService\';\n\nexport interface LeaveItem {\n  id: number;\n  type: \'CP\' | \'RTT\';\n  date: string; // YYYY-MM-DD\n  days: number;\n  label?: string;\n}\n\nconst STORAGE_KEY = \'joursoff_data\';\nconst QUOTA_STORAGE_KEY = \'joursoff_quotas_2026\';\n\nexport default function App() {\n  // Persisted leaves (compatible with original joursoff_data format)\n  const [leaves, setLeaves] = useState<LeaveItem[]>(() => {\n    try {\n      const saved = localStorage.getItem(STORAGE_KEY);\n      if (saved) {\n        const parsed = JSON.parse(saved);\n        if (Array.isArray(parsed)) return parsed;\n      }\n    } catch {\n      // ignore parse errors\n    }\n    return [];\n  });\n\n  // Initial allowances (default 25 CP, 10 RTT)\n  const [quotas, setQuotas] = useState<{ cp: number; rtt: number }>(() => {\n    try {\n      const saved = localStorage.getItem(QUOTA_STORAGE_KEY);\n      if (saved) return JSON.parse(saved);\n    } catch {\n      // ignore\n    }\n    return { cp: 25, rtt: 10 };\n  });\n\n  // Supabase Auth State\n  const [user, setUser] = useState<SupabaseUser | null>(null);\n  const [isAuthModalOpen, setIsAuthModalOpen] = useState(false);\n  const [authMode, setAuthMode] = useState<\'login\' | \'signup\'>(\'login\');\n  const [authEmail, setAuthEmail] = useState(\'\');\n  const [authPassword, setAuthPassword] = useState(\'\');\n  const [authError, setAuthError] = useState<string | null>(null);\n  const [authSuccess, setAuthSuccess] = useState<string | null>(null);\n  const [authSubmitting, setAuthSubmitting] = useState(false);\n  const [isSyncing, setIsSyncing] = useState(false);\n\n  // UI state\n  const [isModalOpen, setIsModalOpen] = useState(false);\n  const [isQuotaModalOpen, setIsQuotaModalOpen] = useState(false);\n  const [quotaFocusField, setQuotaFocusField] = useState<\'cp\' | \'rtt\'>(\'cp\');\n  const [quotaCpInput, setQuotaCpInput] = useState<string>(String(quotas.cp));\n  const [quotaRttInput, setQuotaRttInput] = useState<string>(String(quotas.rtt));\n\n  const [isCodeModalOpen, setIsCodeModalOpen] = useState(false);\n  const [isIOSGuideOpen, setIsIOSGuideOpen] = useState(false);\n  const [copiedCode, setCopiedCode] = useState(false);\n  const [activeBridgeFilter, setActiveBridgeFilter] = useState<\'prioritaires\' | \'tous\'>(\'prioritaires\');\n  const [oneClickType, setOneClickType] = useState<\'RTT\' | \'CP\'>(\'RTT\');\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\n\n  // Form state for manual leave modal\n  const [formType, setFormType] = useState<\'CP\' | \'RTT\'>(\'CP\');\n  const [formDate, setFormDate] = useState<string>(\'2026-05-15\');\n  const [formDays, setFormDays] = useState<string>(\'1\');\n  const [formLabel, setFormLabel] = useState<string>(\'\');\n\n  // PWA install hook\n  const { isInstallable, isInstalled, isIOS, install } = usePWAInstall();\n\n  // Supabase Sync from Cloud\n  const syncFromCloud = useCallback(async (userId: string) => {\n    setIsSyncing(true);\n    try {\n      const { leaves: cloudLeaves, quotas: cloudQuotas } = await fetchUserSettings(userId);\n      if (cloudLeaves && cloudLeaves.length > 0) {\n        setLeaves(cloudLeaves);\n        localStorage.setItem(STORAGE_KEY, JSON.stringify(cloudLeaves));\n      }\n      if (cloudQuotas) {\n        setQuotas(cloudQuotas);\n        localStorage.setItem(QUOTA_STORAGE_KEY, JSON.stringify(cloudQuotas));\n      }\n      // If cloud is empty but local exists, sync local to cloud\n      if ((!cloudLeaves || cloudLeaves.length === 0) && leaves.length > 0) {\n        await saveUserSettings(userId, leaves, quotas);\n      }\n    } finally {\n      setIsSyncing(false);\n    }\n  }, [leaves, quotas]);\n\n  // Init auth session\n  useEffect(() => {\n    supabase.auth.getSession().then(({ data: { session } }) => {\n      const currentUser = session?.user ?? null;\n      setUser(currentUser);\n      if (currentUser) {\n        syncFromCloud(currentUser.id);\n      }\n    });\n\n    const {\n      data: { subscription },\n    } = supabase.auth.onAuthStateChange((_event, session) => {\n      const currentUser = session?.user ?? null;\n      setUser(currentUser);\n      if (currentUser) {\n        syncFromCloud(currentUser.id);\n      }\n    });\n\n    return () => {\n      subscription.unsubscribe();\n    };\n  }, [syncFromCloud]);\n\n  // Persist to localStorage (offline fallback) & Cloud\n  useEffect(() => {\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(leaves));\n    if (user) {\n      saveUserSettings(user.id, leaves, quotas);\n    }\n  }, [leaves, user, quotas]);\n\n  useEffect(() => {\n    localStorage.setItem(QUOTA_STORAGE_KEY, JSON.stringify(quotas));\n    if (user) {\n      saveUserSettings(user.id, leaves, quotas);\n    }\n  }, [quotas, user, leaves]);\n\n  const showToast = (msg: string) => {\n    setToastMessage(msg);\n    setTimeout(() => {\n      setToastMessage((prev) => (prev === msg ? null : prev));\n    }, 3200);\n  };\n\n  const handleAuthSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setAuthError(null);\n    setAuthSuccess(null);\n    setAuthSubmitting(true);\n\n    try {\n      if (authMode === \'login\') {\n        const { error } = await supabase.auth.signInWithPassword({\n          email: authEmail,\n          password: authPassword,\n        });\n        if (error) throw error;\n        setIsAuthModalOpen(false);\n        showToast(\'Connexion r\303\251ussie ! Vos donn\303\251es sont synchronis\303\251es.\');\n      } else {\n        const { error } = await supabase.auth.signUp({\n          email: authEmail,\n          password: authPassword,\n        });\n        if (error) throw error;\n        setAuthSuccess(\n          \'Compte cr\303\251\303\251 avec succ\303\250s ! Si la confirmation par email est activ\303\251e, veuillez v\303\251rifier votre bo\303\256te de r\303\251ception.\'\n        );\n        setTimeout(() => {\n          setIsAuthModalOpen(false);\n        }, 2000);\n      }\n    } catch (err: unknown) {\n      const msg = err instanceof Error ? err.message : \"Erreur d\'authentification\";\n      setAuthError(msg);\n    } finally {\n      setAuthSubmitting(false);\n    }\n  };\n\n  const handleSignOut = async () => {\n    await supabase.auth.signOut();\n    setUser(null);\n    setIsAuthModalOpen(false);\n    showToast(\'D\303\251connect\303\251. Vous \303\252tes repass\303\251 en mode local.\');\n  };\n\n  const openQuotaEditor = (target: \'cp\' | \'rtt\') => {\n    setQuotaCpInput(String(quotas.cp));\n    setQuotaRttInput(String(quotas.rtt));\n    setQuotaFocusField(target);\n    setIsQuotaModalOpen(true);\n  };\n\n  const handleSaveQuotas = (e: React.FormEvent) => {\n    e.preventDefault();\n    const newCp = parseFloat(quotaCpInput);\n    const newRtt = parseFloat(quotaRttInput);\n    if (isNaN(newCp) || newCp < 0 || isNaN(newRtt) || newRtt < 0) return;\n\n    setQuotas({ cp: newCp, rtt: newRtt });\n    setIsQuotaModalOpen(false);\n    showToast(`Soldes initiaux mis \303\240 jour : ${newCp} CP et ${newRtt} RTT.`);\n  };\n\n  // Balances calculation\n  const { cpRemaining, rttRemaining, cpUsed, rttUsed } = useMemo(() => {\n    let cpU = 0;\n    let rttU = 0;\n    for (const item of leaves) {\n      if (item.type === \'CP\') cpU += Number(item.days) || 0;\n      if (item.type === \'RTT\') rttU += Number(item.days) || 0;\n    }\n    return {\n      cpUsed: cpU,\n      rttUsed: rttU,\n      cpRemaining: quotas.cp - cpU,\n      rttRemaining: quotas.rtt - rttU,\n    };\n  }, [leaves, quotas]);\n\n  // All 2026 detected bridges\n  const allBridges = useMemo(() => analyzeBridges2026(FRENCH_HOLIDAYS_2026), []);\n  const holidaySummary = useMemo(() => getHolidayCalendarSummary2026(), []);\n\n  const displayedBridges = useMemo(() => {\n    if (activeBridgeFilter === \'prioritaires\') {\n      return allBridges.filter((b) => b.kind === \'pont_royal\' || b.kind === \'viaduc\');\n    }\n    return allBridges;\n  }, [allBridges, activeBridgeFilter]);\n\n  // Check if a bridge opportunity is already booked\n  const isBridgeBooked = (bridge: BridgeOpportunity) => {\n    return bridge.bridgeDates.every((d) => leaves.some((l) => l.date === d));\n  };\n\n  // 1-Click book or unbook bridge\n  const handleOneClickBridge = (bridge: BridgeOpportunity) => {\n    const alreadyBooked = isBridgeBooked(bridge);\n\n    if (alreadyBooked) {\n      // Remove those bridge dates if user wants to undo\n      setLeaves((prev) => prev.filter((item) => !bridge.bridgeDates.includes(item.date)));\n      showToast(`Pont de ${bridge.holidayName} retir\303\251 de vos jours pos\303\251s.`);\n      return;\n    }\n\n    const newEntries: LeaveItem[] = [];\n    bridge.bridgeDates.forEach((dateStr, idx) => {\n      const exists = leaves.some((l) => l.date === dateStr);\n      if (!exists) {\n        newEntries.push({\n          id: Date.now() + idx,\n          type: oneClickType,\n          date: dateStr,\n          days: 1,\n          label: `Pont ${bridge.holidayName}`,\n        });\n      }\n    });\n\n    if (newEntries.length > 0) {\n      setLeaves((prev) =>\n        [...prev, ...newEntries].sort((a, b) => a.date.localeCompare(b.date))\n      );\n      showToast(\n        `+${newEntries.length} ${oneClickType} pos\303\251 (${bridge.bridgeLabel}) \342\206\222 ${bridge.totalOffDays} jours de repos !`\n      );\n    }\n  };\n\n  // Manual form submission\n  const handleManualSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    const parsedDays = parseFloat(formDays);\n    if (!formDate || isNaN(parsedDays) || parsedDays <= 0) return;\n\n    const newItem: LeaveItem = {\n      id: Date.now(),\n      type: formType,\n      date: formDate,\n      days: parsedDays,\n      label: formLabel.trim() || undefined,\n    };\n\n    setLeaves((prev) =>\n      [...prev, newItem].sort((a, b) => a.date.localeCompare(b.date))\n    );\n    setIsModalOpen(false);\n    setFormLabel(\'\');\n    setFormDays(\'1\');\n    showToast(`Jour off (${formType}) ajout\303\251 pour le ${formatShortDateFr(formDate)}.`);\n  };\n\n  const handleDeleteLeave = (id: number) => {\n    setLeaves((prev) => prev.filter((item) => item.id !== id));\n  };\n\n  const handleCopyStandaloneHtml = async () => {\n    try {\n      await navigator.clipboard.writeText(STANDALONE_HTML_CODE);\n      setCopiedCode(true);\n      showToast(\'Code index.html complet copi\303\251 dans le presse-papiers !\');\n      setTimeout(() => setCopiedCode(false), 2500);\n    } catch {\n      // Fallback textarea copy\n      const textarea = document.createElement(\'textarea\');\n      textarea.value = STANDALONE_HTML_CODE;\n      document.body.appendChild(textarea);\n      textarea.select();\n      document.execCommand(\'copy\');\n      document.body.removeChild(textarea);\n      setCopiedCode(true);\n      showToast(\'Code index.html complet copi\303\251 !\');\n      setTimeout(() => setCopiedCode(false), 2500);\n    }\n  };\n\n  const handleDownloadStandaloneHtml = () => {\n    const blob = new Blob([STANDALONE_HTML_CODE], { type: \'text/html;charset=utf-8\' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = \'index.html\';\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n    URL.revokeObjectURL(url);\n    showToast(\'Fichier index.html t\303\251l\303\251charg\303\251.\');\n  };\n\n  const formatFrNumber = (n: number) => n.toFixed(1).replace(\'.\', \',\');\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900 flex flex-col\">\n      {/* Top Bar Contract: 3 zones (Brand, Nav Links, Primary Actions) */}\n      <header className=\"sticky top-0 z-30 bg-white/90 backdrop-blur-md border-b border-slate-200/80 px-4 sm:px-8 h-16 flex items-center justify-between\">\n        {/* Zone 1: Single text element wordmark */}\n        <a href=\"#top\" className=\"text-xl font-extrabold tracking-tight text-indigo-600\">\n          JoursOff\n        </a>\n\n        {/* Zone 2: Clean text navigation links */}\n        <nav className=\"hidden md:flex items-center gap-6 text-sm font-medium text-slate-600\">\n          <a href=\"#soldes\" className=\"hover:text-slate-900 hover:underline underline-offset-4 transition-colors\">\n            Soldes 2026\n          </a>\n          <a href=\"#optimiseur\" className=\"hover:text-slate-900 hover:underline underline-offset-4 transition-colors\">\n            Optimiseur de Ponts\n          </a>\n          <a href=\"#absences\" className=\"hover:text-slate-900 hover:underline underline-offset-4 transition-colors\">\n            Jours pos\303\251s\n          </a>\n          <a href=\"#calendrier\" className=\"hover:text-slate-900 hover:underline underline-offset-4 transition-colors\">\n            11 Jours f\303\251ri\303\251s\n          </a>\n        </nav>\n\n        {/* Zone 3: 1-2 Primary Actions */}\n        <div className=\"flex items-center gap-2.5\">\n          {!isInstalled && isInstallable && (\n            <button\n              onClick={install}\n              className=\"px-3.5 py-2 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors whitespace-nowrap flex items-center gap-1.5 cursor-pointer\"\n            >\n              <Smartphone className=\"w-3.5 h-3.5 text-indigo-600\" />\n              <span>Installer l&apos;app</span>\n            </button>\n          )}\n          {!isInstalled && !isInstallable && isIOS && (\n            <button\n              onClick={() => setIsIOSGuideOpen(true)}\n              className=\"px-3.5 py-2 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors whitespace-nowrap flex items-center gap-1.5 cursor-pointer\"\n            >\n              <Smartphone className=\"w-3.5 h-3.5 text-indigo-600\" />\n              <span>Installer iOS</span>\n            </button>\n          )}\n\n          <button\n            onClick={() => setIsCodeModalOpen(true)}\n            className=\"px-3.5 py-2 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors whitespace-nowrap flex items-center gap-1.5 cursor-pointer\"\n          >\n            <Code2 className=\"w-3.5 h-3.5 text-indigo-600\" />\n            <span>Code HTML</span>\n          </button>\n\n          <button\n            onClick={() => setIsModalOpen(true)}\n            className=\"px-4 py-2 text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl transition-colors whitespace-nowrap flex items-center gap-1.5 cursor-pointer\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            <span>Poser un jour off</span>\n          </button>\n        </div>\n      </header>\n\n      {/* Toast Notification */}\n      {toastMessage && (\n        <div className=\"fixed bottom-5 right-5 z-50 bg-slate-900 text-white text-xs font-semibold px-4 py-3 rounded-2xl shadow-lg flex items-center gap-2.5 max-w-sm\">\n          <Check className=\"w-4 h-4 text-emerald-400 shrink-0\" />\n          <span>{toastMessage}</span>\n        </div>\n      )}\n\n      {/* Main Content Container */}\n      <main id=\"top\" className=\"flex-1 max-w-6xl w-full mx-auto px-4 sm:px-8 py-8\">\n        {/* Top Intro & Quick Copy Bar */}\n        <div className=\"flex flex-col lg:flex-row lg:items-end justify-between gap-4 mb-8 pb-6 border-b border-slate-200/80\">\n          <div>\n            <p className=\"text-xs font-semibold text-indigo-600 mb-1\">\n              Suivi de cong\303\251s & RTT \302\267 Calendrier fran\303\247ais 2026\n            </p>\n            <h1 className=\"text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight\">\n              Mes cong\303\251s, RTT & ponts 2026 sous contr\303\264le\n            </h1>\n            <p className=\"text-sm text-slate-600 mt-1\">\n              Rep\303\251rez les mardis, mercredis et jeudis f\303\251ri\303\251s de 2026 et posez vos ponts en 1 clic avec calcul instantan\303\251 du solde.\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-2.5 shrink-0\">\n            <button\n              onClick={handleCopyStandaloneHtml}\n              className=\"px-3.5 py-2.5 rounded-xl bg-white border border-slate-200 hover:border-slate-300 text-xs font-bold text-slate-700 flex items-center gap-2 transition cursor-pointer\"\n            >\n              {copiedCode ? (\n                <>\n                  <Check className=\"w-4 h-4 text-emerald-600\" />\n                  <span className=\"text-emerald-700\">index.html copi\303\251 !</span>\n                </>\n              ) : (\n                <>\n                  <Copy className=\"w-4 h-4 text-indigo-600\" />\n                  <span>Copier index.html autonome</span>\n                </>\n              )}\n            </button>\n            <button\n              onClick={handleDownloadStandaloneHtml}\n              className=\"px-3.5 py-2.5 rounded-xl bg-white border border-slate-200 hover:border-slate-300 text-xs font-bold text-slate-700 flex items-center gap-2 transition cursor-pointer\"\n            >\n              <Download className=\"w-4 h-4 text-slate-600\" />\n              <span>T\303\251l\303\251charger .html</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Responsive 12-Column Layout: Left Column (Mobile App Preview / Balances & Absences) + Right Column (Optimiseur de Ponts 2026 & 11 Jours F\303\251ri\303\251s) */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n          {/* LEFT COLUMN (5 cols on desktop): Soldes + Bouton Action + Mes Jours Pos\303\251s */}\n          <div className=\"lg:col-span-5 space-y-6\" id=\"soldes\">\n            {/* Cartes de Solde */}\n            <div className=\"grid grid-cols-2 gap-3.5\">\n              <div className=\"bg-white p-5 rounded-2xl border border-slate-200/80\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-xs text-slate-500 font-semibold\">Cong\303\251s Pay\303\251s</span>\n                  <button\n                    type=\"button\"\n                    onClick={() => openQuotaEditor(\'cp\')}\n                    className=\"text-slate-400 hover:text-indigo-600 p-1.5 -mr-1.5 rounded-xl hover:bg-slate-50 transition cursor-pointer\"\n                    title=\"Modifier le solde initial de Cong\303\251s Pay\303\251s\"\n                    aria-label=\"Modifier le solde initial de Cong\303\251s Pay\303\251s\"\n                  >\n                    <Pencil className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n                <p\n                  id=\"cp-count\"\n                  className=\"text-3xl font-extrabold text-slate-900 mt-1.5 font-mono-tabular\"\n                >\n                  {formatFrNumber(cpRemaining)}\n                </p>\n                <div className=\"mt-2 flex items-center justify-between text-xs text-slate-500\">\n                  <span className=\"text-emerald-700 font-semibold\">jours restants</span>\n                  <button\n                    type=\"button\"\n                    onClick={() => openQuotaEditor(\'cp\')}\n                    className=\"font-mono-tabular hover:text-indigo-600 underline decoration-dotted underline-offset-2 cursor-pointer\"\n                    title=\"Cliquer pour ajuster le solde de d\303\251part\"\n                  >\n                    sur {String(quotas.cp).replace(\'.\', \',\')}j\n                  </button>\n                </div>\n              </div>\n\n              <div className=\"bg-white p-5 rounded-2xl border border-slate-200/80\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-xs text-slate-500 font-semibold\">RTT</span>\n                  <button\n                    type=\"button\"\n                    onClick={() => openQuotaEditor(\'rtt\')}\n                    className=\"text-slate-400 hover:text-indigo-600 p-1.5 -mr-1.5 rounded-xl hover:bg-slate-50 transition cursor-pointer\"\n                    title=\"Modifier le solde initial de RTT\"\n                    aria-label=\"Modifier le solde initial de RTT\"\n                  >\n                    <Pencil className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n                <p\n                  id=\"rtt-count\"\n                  className=\"text-3xl font-extrabold text-indigo-600 mt-1.5 font-mono-tabular\"\n                >\n                  {formatFrNumber(rttRemaining)}\n                </p>\n                <div className=\"mt-2 flex items-center justify-between text-xs text-slate-500\">\n                  <span className=\"text-indigo-600 font-semibold\">jours restants</span>\n                  <button\n                    type=\"button\"\n                    onClick={() => openQuotaEditor(\'rtt\')}\n                    className=\"font-mono-tabular hover:text-indigo-600 underline decoration-dotted underline-offset-2 cursor-pointer\"\n                    title=\"Cliquer pour ajuster le solde de d\303\251part\"\n                  >\n                    sur {String(quotas.rtt).replace(\'.\', \',\')}j\n                  </button>\n                </div>\n              </div>\n            </div>\n\n            {/* Bouton d\'action principal */}\n            <button\n              onClick={() => setIsModalOpen(true)}\n              className=\"w-full bg-indigo-600 text-white font-bold py-3.5 px-4 rounded-2xl hover:bg-indigo-700 active:scale-[0.99] transition flex items-center justify-center gap-2 cursor-pointer\"\n            >\n              <Plus className=\"w-5 h-5\" />\n              <span>+ Poser un jour off</span>\n            </button>\n\n            {/* Liste des absences (\"Mes jours pos\303\251s\") */}\n            <section id=\"absences\" className=\"pt-2\">\n              <div className=\"flex items-center justify-between mb-3\">\n                <div>\n                  <h2 className=\"text-sm font-extrabold text-slate-900\">Mes jours pos\303\251s</h2>\n                  <p className=\"text-xs text-slate-500\">\n                    Synchronis\303\251s automatiquement avec votre solde\n                  </p>\n                </div>\n                {leaves.length > 0 && (\n                  <button\n                    onClick={() => {\n                      setLeaves([]);\n                      showToast(\'Tous les jours pos\303\251s ont \303\251t\303\251 r\303\251initialis\303\251s.\');\n                    }}\n                    className=\"text-xs font-semibold text-slate-500 hover:text-red-600 flex items-center gap-1 transition cursor-pointer\"\n                  >\n                    <RotateCcw className=\"w-3.5 h-3.5\" />\n                    <span>Tout effacer</span>\n                  </button>\n                )}\n              </div>\n\n              <div id=\"leave-list\" className=\"space-y-2.5\">\n                {leaves.length === 0 ? (\n                  <div className=\"bg-white rounded-2xl border border-slate-200/80 p-6 text-center\">\n                    <p className=\"text-xs text-slate-500\">\n                      Aucun jour pos\303\251 pour l&apos;instant. Cliquez sur{\' \'}\n                      <strong className=\"text-slate-700\">+ Poser en 1 clic</strong> dans\n                      l&apos;Optimiseur de Ponts 2026 pour d\303\251marrer !\n                    </p>\n                  </div>\n                ) : (\n                  leaves.map((item) => {\n                    const [y, m, d] = item.date.split(\'-\').map(Number);\n                    const dateObj = new Date(y, m - 1, d);\n                    const dateFormatted = dateObj.toLocaleDateString(\'fr-FR\', {\n                      weekday: \'short\',\n                      day: \'numeric\',\n                      month: \'short\',\n                    });\n\n                    return (\n                      <div\n                        key={item.id}\n                        className=\"bg-white p-3.5 rounded-2xl border border-slate-200/80 flex justify-between items-center hover:border-slate-300 transition\"\n                      >\n                        <div className=\"flex items-center gap-2.5 min-w-0\">\n                          <span\n                            className={`text-xs font-extrabold shrink-0 ${\n                              item.type === \'CP\' ? \'text-emerald-700\' : \'text-indigo-600\'\n                            }`}\n                          >\n                            {item.type}\n                          </span>\n                          <span className=\"text-slate-300\" aria-hidden=\"true\">\n                            \302\267\n                          </span>\n                          <span className=\"text-xs font-semibold text-slate-800 capitalize truncate\">\n                            {dateFormatted}\n                          </span>\n                          {item.label && (\n                            <>\n                              <span className=\"text-slate-300\" aria-hidden=\"true\">\n                                \302\267\n                              </span>\n                              <span className=\"text-xs text-slate-500 truncate\">\n                                {item.label}\n                              </span>\n                            </>\n                          )}\n                        </div>\n                        <div className=\"flex items-center gap-3 shrink-0\">\n                          <span className=\"text-xs font-bold text-slate-700 font-mono-tabular\">\n                            -{String(item.days).replace(\'.\', \',\')} j\n                          </span>\n                          <button\n                            onClick={() => handleDeleteLeave(item.id)}\n                            className=\"text-slate-400 hover:text-red-600 p-1.5 rounded-lg hover:bg-red-50 transition cursor-pointer\"\n                            title=\"Supprimer ce jour off\"\n                            aria-label=\"Supprimer ce jour off\"\n                          >\n                            <Trash2 className=\"w-4 h-4\" />\n                          </button>\n                        </div>\n                      </div>\n                    );\n                  })\n                )}\n              </div>\n            </section>\n          </div>\n\n          {/* RIGHT COLUMN (7 cols on desktop): Optimiseur de Ponts 2026 + Calendrier des 11 Jours F\303\251ri\303\251s */}\n          <div className=\"lg:col-span-7 space-y-8\" id=\"optimiseur\">\n            {/* Section Bons plans de ponts 2026 */}\n            <section>\n              <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4\">\n                <div>\n                  <div className=\"flex items-center gap-2\">\n                    <Sparkles className=\"w-4 h-4 text-indigo-600\" />\n                    <h2 className=\"text-base font-extrabold text-slate-900\">\n                      Optimiseur de Ponts 2026 \342\200\224 Bons plans de ponts\n                    </h2>\n                  </div>\n                  <p className=\"text-xs text-slate-500 mt-0.5\">\n                    3 ponts royaux (mardi/jeudi f\303\251ri\303\251s : 1j pos\303\251 = 4j off) et 1 viaduc (mercredi 11 nov : 2j pos\303\251s = 5j off)\n                  </p>\n                </div>\n\n                {/* Controls: Choose whether 1-click deducts RTT or CP */}\n                <div className=\"flex items-center gap-2 self-start sm:self-auto\">\n                  <span className=\"text-xs text-slate-500 font-medium\">Poser en :</span>\n                  <div className=\"flex items-center gap-1 p-1 bg-slate-200/70 rounded-xl\">\n                    <button\n                      type=\"button\"\n                      onClick={() => setOneClickType(\'RTT\')}\n                      className={`px-3 py-1 text-xs font-bold rounded-lg transition cursor-pointer whitespace-nowrap ${\n                        oneClickType === \'RTT\'\n                          ? \'bg-white text-indigo-700 shadow-xs\'\n                          : \'text-slate-600 hover:text-slate-900\'\n                      }`}\n                    >\n                      RTT\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => setOneClickType(\'CP\')}\n                      className={`px-3 py-1 text-xs font-bold rounded-lg transition cursor-pointer whitespace-nowrap ${\n                        oneClickType === \'CP\'\n                          ? \'bg-white text-emerald-700 shadow-xs\'\n                          : \'text-slate-600 hover:text-slate-900\'\n                      }`}\n                    >\n                      CP\n                    </button>\n                  </div>\n                </div>\n              </div>\n\n              {/* Filter Tabs */}\n              <div className=\"flex items-center gap-1 p-1 bg-slate-200/60 rounded-xl w-fit mb-4\">\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveBridgeFilter(\'prioritaires\')}\n                  className={`px-3.5 py-1.5 text-xs font-semibold rounded-lg transition cursor-pointer whitespace-nowrap ${\n                    activeBridgeFilter === \'prioritaires\'\n                      ? \'bg-white text-slate-900 shadow-xs\'\n                      : \'text-slate-600 hover:text-slate-900\'\n                  }`}\n                >\n                  Ponts Mardi / Mercredi / Jeudi (4)\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveBridgeFilter(\'tous\')}\n                  className={`px-3.5 py-1.5 text-xs font-semibold rounded-lg transition cursor-pointer whitespace-nowrap ${\n                    activeBridgeFilter === \'tous\'\n                      ? \'bg-white text-slate-900 shadow-xs\'\n                      : \'text-slate-600 hover:text-slate-900\'\n                  }`}\n                >\n                  Avec week-ends prolong\303\251s (9)\n                </button>\n              </div>\n\n              {/* Opportunity Cards Grid */}\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                {displayedBridges.map((bridge) => {\n                  const booked = isBridgeBooked(bridge);\n                  return (\n                    <div\n                      key={bridge.id}\n                      className={`bg-white rounded-2xl p-5 border transition flex flex-col justify-between ${\n                        booked\n                          ? \'border-emerald-300 bg-emerald-50/15\'\n                          : \'border-slate-200/80 hover:border-slate-300\'\n                      }`}\n                    >\n                      <div>\n                        {/* Quiet 1-line text kicker with middle-dot separators (Zero-Pill Discipline) */}\n                        <div className=\"flex items-center gap-1.5 text-xs text-slate-500 font-medium\">\n                          <span className=\"font-semibold text-indigo-600\">\n                            {bridge.holidayName}\n                          </span>\n                          <span aria-hidden=\"true\">\302\267</span>\n                          <span>{bridge.holidayDayLabel}</span>\n                          <span aria-hidden=\"true\">\302\267</span>\n                          <span className=\"font-mono-tabular font-semibold text-emerald-700\">\n                            Rendement \303\227{(bridge.totalOffDays / bridge.costDays).toFixed(0)}\n                          </span>\n                        </div>\n\n                        <h3 className=\"text-base font-extrabold text-slate-900 mt-1.5\">\n                          Poser le {bridge.bridgeLabel}\n                        </h3>\n\n                        <p className=\"text-xs text-slate-600 mt-1 flex items-center gap-1.5\">\n                          <span>{bridge.restSpanLabel}</span>\n                          <ArrowRight className=\"w-3.5 h-3.5 text-slate-400 shrink-0\" />\n                          <strong className=\"text-slate-900 font-mono-tabular\">\n                            {bridge.costDays}j pos\303\251 = {bridge.totalOffDays}j de repos\n                          </strong>\n                        </p>\n\n                        {/* Visual Day Strip */}\n                        <div className=\"grid grid-cols-4 sm:grid-cols-5 gap-1.5 mt-4 pt-3 border-t border-slate-100\">\n                          {bridge.timeline.map((slot) => (\n                            <div\n                              key={slot.date}\n                              className={`rounded-xl px-2 py-1.5 text-center border ${\n                                slot.status === \'ferie\'\n                                  ? \'bg-indigo-50/70 border-indigo-200 text-indigo-900\'\n                                  : slot.status === \'pont\'\n                                  ? \'bg-amber-50/80 border-amber-300 text-amber-900\'\n                                  : \'bg-slate-50 border-slate-200/70 text-slate-600\'\n                              }`}\n                            >\n                              <div className=\"text-[11px] font-bold font-mono-tabular\">\n                                {slot.label}\n                              </div>\n                              <div className=\"text-[10px] font-medium mt-0.5\">\n                                {slot.status === \'ferie\'\n                                  ? \'F\303\251ri\303\251\'\n                                  : slot.status === \'pont\'\n                                  ? \'\303\200 poser\'\n                                  : \'Repos\'}\n                              </div>\n                            </div>\n                          ))}\n                        </div>\n                      </div>\n\n                      <div className=\"mt-4 pt-3 border-t border-slate-100 flex items-center justify-between gap-2\">\n                        <span className=\"text-xs text-slate-500 font-mono-tabular\">\n                          Co\303\273t : -{bridge.costDays} {oneClickType}\n                        </span>\n\n                        <button\n                          type=\"button\"\n                          onClick={() => handleOneClickBridge(bridge)}\n                          className={`px-3.5 py-2 rounded-xl text-xs font-bold flex items-center gap-1.5 transition cursor-pointer whitespace-nowrap ${\n                            booked\n                              ? \'bg-emerald-100 text-emerald-800 hover:bg-emerald-200\'\n                              : \'bg-indigo-600 text-white hover:bg-indigo-700 active:scale-[0.98]\'\n                          }`}\n                        >\n                          {booked ? (\n                            <>\n                              <Check className=\"w-3.5 h-3.5\" />\n                              <span>Pos\303\251 \302\267 Retirer</span>\n                            </>\n                          ) : (\n                            <>\n                              <Zap className=\"w-3.5 h-3.5\" />\n                              <span>+ Poser en 1 clic ({oneClickType})</span>\n                            </>\n                          )}\n                        </button>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            </section>\n\n            {/* Section : Analyse compl\303\250te des 11 jours f\303\251ri\303\251s fran\303\247ais 2026 */}\n            <section id=\"calendrier\" className=\"bg-white rounded-2xl border border-slate-200/80 p-5\">\n              <div className=\"flex items-center justify-between mb-4\">\n                <div>\n                  <h2 className=\"text-sm font-extrabold text-slate-900 flex items-center gap-2\">\n                    <Calendar className=\"w-4 h-4 text-indigo-600\" />\n                    Calendrier officiel des 11 jours f\303\251ri\303\251s 2026\n                  </h2>\n                  <p className=\"text-xs text-slate-500 mt-0.5\">\n                    Diagnostic automatique des ponts et week-ends prolong\303\251s en France\n                  </p>\n                </div>\n              </div>\n\n              <div className=\"divide-y divide-slate-100\">\n                {holidaySummary.map((h) => (\n                  <div\n                    key={h.date}\n                    className=\"py-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-xs\"\n                  >\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"font-bold text-slate-900\">{h.name}</span>\n                      <span className=\"text-slate-300\" aria-hidden=\"true\">\n                        \302\267\n                      </span>\n                      <span className=\"text-slate-600 font-mono-tabular\">\n                        {h.dayFull} {h.formattedDate} 2026\n                      </span>\n                    </div>\n                    <div className=\"flex items-center gap-2\">\n                      <span\n                        className={`font-semibold ${\n                          h.status === \'pont_mardi_jeudi\'\n                            ? \'text-indigo-600\'\n                            : h.status === \'viaduc_mercredi\'\n                            ? \'text-amber-700\'\n                            : h.status === \'weekend_3j\'\n                            ? \'text-emerald-700\'\n                            : \'text-slate-400\'\n                        }`}\n                      >\n                        {h.note}\n                      </span>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </section>\n          </div>\n        </div>\n      </main>\n\n      {/* Modal: Modifier les soldes de d\303\251part (CP et RTT) */}\n      {isQuotaModalOpen && (\n        <div className=\"fixed inset-0 bg-slate-900/40 backdrop-blur-xs flex items-end sm:items-center justify-center p-4 z-50\">\n          <div className=\"bg-white w-full max-w-sm rounded-3xl p-6 shadow-xl border border-slate-100 space-y-4\">\n            <div className=\"flex justify-between items-center\">\n              <div className=\"flex items-center gap-2\">\n                <SlidersHorizontal className=\"w-5 h-5 text-indigo-600\" />\n                <h3 className=\"font-extrabold text-slate-900 text-lg\">\n                  Soldes de d\303\251part 2026\n                </h3>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => setIsQuotaModalOpen(false)}\n                className=\"text-slate-400 hover:text-slate-700 p-1 rounded-lg cursor-pointer\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            <p className=\"text-xs text-slate-500 leading-relaxed\">\n              Ajustez votre nombre total de Cong\303\251s Pay\303\251s et de RTT pour l&apos;ann\303\251e. Vos jours d\303\251j\303\240 pos\303\251s ({formatFrNumber(cpUsed)} CP et {formatFrNumber(rttUsed)} RTT) seront d\303\251duits automatiquement.\n            </p>\n\n            <form onSubmit={handleSaveQuotas} className=\"space-y-3.5\">\n              <div>\n                <label className=\"block text-xs font-bold text-slate-600 mb-1\">\n                  Solde initial Cong\303\251s Pay\303\251s (CP)\n                </label>\n                <input\n                  type=\"number\"\n                  step=\"0.5\"\n                  min=\"0\"\n                  max=\"120\"\n                  autoFocus={quotaFocusField === \'cp\'}\n                  value={quotaCpInput}\n                  onChange={(e) => setQuotaCpInput(e.target.value)}\n                  required\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm font-bold text-slate-900 focus:outline-indigo-600 font-mono-tabular\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-600 mb-1\">\n                  Solde initial RTT\n                </label>\n                <input\n                  type=\"number\"\n                  step=\"0.5\"\n                  min=\"0\"\n                  max=\"120\"\n                  autoFocus={quotaFocusField === \'rtt\'}\n                  value={quotaRttInput}\n                  onChange={(e) => setQuotaRttInput(e.target.value)}\n                  required\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm font-bold text-indigo-600 focus:outline-indigo-600 font-mono-tabular\"\n                />\n              </div>\n\n              <div className=\"pt-2 flex gap-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => setIsQuotaModalOpen(false)}\n                  className=\"w-1/2 bg-slate-100 text-slate-600 font-bold py-3 rounded-xl hover:bg-slate-200 transition cursor-pointer\"\n                >\n                  Annuler\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"w-1/2 bg-indigo-600 text-white font-bold py-3 rounded-xl hover:bg-indigo-700 transition cursor-pointer\"\n                >\n                  Enregistrer\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n\n      {/* Modal: Poser un jour off manuellement */}\n      {isModalOpen && (\n        <div className=\"fixed inset-0 bg-slate-900/40 backdrop-blur-xs flex items-end sm:items-center justify-center p-4 z-50\">\n          <div className=\"bg-white w-full max-w-sm rounded-3xl p-6 shadow-xl border border-slate-100 space-y-4\">\n            <div className=\"flex justify-between items-center\">\n              <h3 className=\"font-extrabold text-slate-900 text-lg\">Nouveau jour off</h3>\n              <button\n                type=\"button\"\n                onClick={() => setIsModalOpen(false)}\n                className=\"text-slate-400 hover:text-slate-700 p-1 rounded-lg cursor-pointer\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            <form onSubmit={handleManualSubmit} className=\"space-y-3.5\">\n              <div>\n                <label className=\"block text-xs font-bold text-slate-600 mb-1\">\n                  Type de cong\303\251\n                </label>\n                <select\n                  value={formType}\n                  onChange={(e) => setFormType(e.target.value as \'CP\' | \'RTT\')}\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm font-medium focus:outline-indigo-600\"\n                >\n                  <option value=\"CP\">Cong\303\251 Pay\303\251 (CP)</option>\n                  <option value=\"RTT\">RTT</option>\n                </select>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-600 mb-1\">\n                  Date\n                </label>\n                <input\n                  type=\"date\"\n                  value={formDate}\n                  min=\"2026-01-01\"\n                  max=\"2026-12-31\"\n                  onChange={(e) => setFormDate(e.target.value)}\n                  required\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm font-medium focus:outline-indigo-600 font-mono-tabular\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-600 mb-1\">\n                  Dur\303\251e (jours)\n                </label>\n                <input\n                  type=\"number\"\n                  step=\"0.5\"\n                  min=\"0.5\"\n                  max=\"30\"\n                  value={formDays}\n                  onChange={(e) => setFormDays(e.target.value)}\n                  required\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm font-medium focus:outline-indigo-600 font-mono-tabular\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-600 mb-1\">\n                  Note (optionnel)\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"Ex: Pont de l\'Ascension, Vacances d\'\303\251t\303\251...\"\n                  value={formLabel}\n                  onChange={(e) => setFormLabel(e.target.value)}\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm font-medium focus:outline-indigo-600\"\n                />\n              </div>\n\n              <div className=\"pt-2 flex gap-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => setIsModalOpen(false)}\n                  className=\"w-1/2 bg-slate-100 text-slate-600 font-bold py-3 rounded-xl hover:bg-slate-200 transition cursor-pointer\"\n                >\n                  Annuler\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"w-1/2 bg-indigo-600 text-white font-bold py-3 rounded-xl hover:bg-indigo-700 transition cursor-pointer\"\n                >\n                  Valider\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n\n      {/* Modal: Code HTML unique pr\303\252t \303\240 copier-coller */}\n      {isCodeModalOpen && (\n        <div className=\"fixed inset-0 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4 z-50\">\n          <div className=\"bg-white w-full max-w-3xl rounded-3xl p-6 shadow-xl border border-slate-200 flex flex-col max-h-[85vh]\">\n            <div className=\"flex items-center justify-between pb-4 border-b border-slate-100\">\n              <div>\n                <h3 className=\"font-extrabold text-slate-900 text-lg\">\n                  Fichier unique index.html (HTML + Tailwind CDN + Lucide Icons)\n                </h3>\n                <p className=\"text-xs text-slate-500\">\n                  Pr\303\252t \303\240 \303\252tre copi\303\251-coll\303\251 et ex\303\251cut\303\251 directement dans n&apos;importe quel navigateur\n                </p>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => setIsCodeModalOpen(false)}\n                className=\"text-slate-400 hover:text-slate-700 p-1 rounded-lg cursor-pointer\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            <div className=\"my-4 flex-1 overflow-auto bg-slate-950 text-slate-100 rounded-2xl p-4 text-xs font-mono leading-relaxed\">\n              <pre className=\"whitespace-pre-wrap break-words\">{STANDALONE_HTML_CODE}</pre>\n            </div>\n\n            <div className=\"flex items-center justify-end gap-3 pt-2\">\n              <button\n                type=\"button\"\n                onClick={handleDownloadStandaloneHtml}\n                className=\"px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold flex items-center gap-2 transition cursor-pointer\"\n              >\n                <Download className=\"w-4 h-4\" />\n                <span>T\303\251l\303\251charger index.html</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={handleCopyStandaloneHtml}\n                className=\"px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold flex items-center gap-2 transition cursor-pointer\"\n              >\n                <Copy className=\"w-4 h-4\" />\n                <span>{copiedCode ? \'Copi\303\251 !\' : \'Copier tout le code\'}</span>\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Modal: Guide d\'installation iOS Safari */}\n      {isIOSGuideOpen && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4\">\n          <div className=\"w-full max-w-sm rounded-3xl bg-white p-6 shadow-xl\">\n            <h3 className=\"text-base font-extrabold text-slate-900\">\n              Installer JoursOff sur iPhone / iPad\n            </h3>\n            <p className=\"mt-2 text-xs text-slate-600 leading-relaxed\">\n              1. Appuyez sur le bouton <strong>Partager</strong> dans la barre de Safari.\n              <br />\n              2. Faites d\303\251filer et appuyez sur <strong>Sur l&apos;\303\251cran d&apos;accueil</strong>.\n            </p>\n            <button\n              type=\"button\"\n              onClick={() => setIsIOSGuideOpen(false)}\n              className=\"mt-4 w-full rounded-xl bg-slate-100 py-2.5 text-xs font-bold text-slate-800 hover:bg-slate-200 cursor-pointer\"\n            >\n              Fermer\n            </button>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n"
    num_lines: 1126
    num_bytes: 47843
  }
}
