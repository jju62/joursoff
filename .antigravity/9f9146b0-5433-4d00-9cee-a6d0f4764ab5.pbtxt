      checkpoint_index: -1
      created_at {
        seconds: 1791207090
        nanos: 147212009
      }
      time_since_last_invocation {
        seconds: 1
        nanos: 491231319
      }
      context_window_metadata {
        estimated_tokens_used: 145165
        token_breakdown {
