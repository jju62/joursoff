    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { supabase } from \'./supabase\';\nimport { LeaveItem } from \'./App\';\n\nexport interface UserQuotas {\n  cp: number;\n  rtt: number;\n}\n\nexport async function fetchUserSettings(userId: string): Promise<{\n  leaves: LeaveItem[] | null;\n  quotas: UserQuotas | null;\n}> {\n  try {\n    const { data, error } = await supabase\n      .from(\'user_settings\')\n      .select(\'*\')\n      .eq(\'user_id\', userId)\n      .maybeSingle();\n\n    if (error) {\n      console.warn(\'Erreur lecture user_settings:\', error.message);\n      return { leaves: null, quotas: null };\n    }\n\n    if (!data) {\n      return { leaves: null, quotas: null };\n    }\n\n    let leaves: LeaveItem[] | null = null;\n    let quotas: UserQuotas | null = null;\n\n    // Parser les feuilles de cong\303\251s\n    if (Array.isArray(data.leaves)) {\n      leaves = data.leaves;\n    } else if (typeof data.leaves === \'string\') {\n      try {\n        leaves = JSON.parse(data.leaves);\n      } catch {}\n    } else if (data.data?.leaves) {\n      leaves = data.data.leaves;\n    } else if (data.settings?.leaves) {\n      leaves = data.settings.leaves;\n    }\n\n    // Parser les soldes CP / RTT\n    if (data.quotas && typeof data.quotas === \'object\') {\n      quotas = {\n        cp: Number(data.quotas.cp ?? 25),\n        rtt: Number(data.quotas.rtt ?? 10),\n      };\n    } else if (typeof data.quotas === \'string\') {\n      try {\n        const q = JSON.parse(data.quotas);\n        quotas = { cp: Number(q.cp ?? 25), rtt: Number(q.rtt ?? 10) };\n      } catch {}\n    } else if (data.cp_quota !== undefined || data.rtt_quota !== undefined) {\n      quotas = {\n        cp: Number(data.cp_quota ?? 25),\n        rtt: Number(data.rtt_quota ?? 10),\n      };\n    } else if (data.data?.quotas) {\n      quotas = data.data.quotas;\n    } else if (data.settings?.quotas) {\n      quotas = data.settings.quotas;\n    }\n\n    return { leaves, quotas };\n  } catch (err) {\n    console.error(\'Erreur inattendue fetchUserSettings:\', err);\n    return { leaves: null, quotas: null };\n  }\n}\n\nexport async function saveUserSettings(\n  userId: string,\n  leaves: LeaveItem[],\n  quotas: UserQuotas\n): Promise<boolean> {\n  try {\n    const updatedAt = new Date().toISOString();\n\n    // Tentative 1: Sch\303\251ma complet avec leaves + quotas\n    const attempt1 = await supabase\n      .from(\'user_settings\')\n      .upsert(\n        {\n          user_id: userId,\n          leaves: leaves,\n          quotas: quotas,\n          updated_at: updatedAt,\n        },\n        { onConflict: \'user_id\' }\n      );\n\n    if (!attempt1.error) return true;\n\n    // Tentative 2: Colonnes cp_quota, rtt_quota, leaves\n    const attempt2 = await supabase\n      .from(\'user_settings\')\n      .upsert(\n        {\n          user_id: userId,\n          leaves: leaves,\n          cp_quota: quotas.cp,\n          rtt_quota: quotas.rtt,\n          updated_at: updatedAt,\n        },\n        { onConflict: \'user_id\' }\n      );\n\n    if (!attempt2.error) return true;\n\n    // Tentative 3: Colonne unique data (JSONB)\n    const attempt3 = await supabase\n      .from(\'user_settings\')\n      .upsert(\n        {\n          user_id: userId,\n          data: { leaves, quotas },\n          updated_at: updatedAt,\n        },\n        { onConflict: \'user_id\' }\n      );\n\n    if (!attempt3.error) return true;\n\n    // Tentative 4: Colonne settings (JSONB)\n    const attempt4 = await supabase\n      .from(\'user_settings\')\n      .upsert(\n        {\n          user_id: userId,\n          settings: { leaves, quotas },\n          updated_at: updatedAt,\n        },\n        { onConflict: \'user_id\' }\n      );\n\n    if (!attempt4.error) return true;\n\n    console.warn(\'Impossible de sauvegarder dans user_settings:\', attempt4.error);\n    return false;\n  } catch (err) {\n    console.error(\'Erreur saveUserSettings:\', err);\n    return false;\n  }\n}\n"
    }
