  planner_response {
    response: "Voici le code complet de votre fichier `index.html`, directement pr\303\252t \303\240 \303\252tre copi\303\251-coll\303\251 et ouvert dans un navigateur, avec Tailwind CSS, Lucide Icons et le module **Optimiseur de Ponts 2026** int\303\251gr\303\251 :\n\n```html\n<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>JoursOff 2026 \342\200\224 Suivi Cong\303\251s, RTT & Ponts</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script src=\"https://unpkg.com/lucide@latest\"></script>\n</head>\n<body class=\"bg-slate-50 text-slate-800 p-4 max-w-md mx-auto min-h-screen pb-12\">\n\n  <!-- En-t\303\252te -->\n  <header class=\"my-6 flex justify-between items-center\">\n    <div>\n      <h1 class=\"text-2xl font-black text-indigo-600 tracking-tight flex items-center gap-2\">\n        <i data-lucide=\"calendar-Range\" class=\"w-6 h-6\"></i>\n        <span>JoursOff</span>\n      </h1>\n      <p class=\"text-xs text-slate-500 font-medium\">Cong\303\251s, RTT & optimiseur de ponts</p>\n    </div>\n    <span class=\"bg-indigo-50 text-indigo-700 text-xs font-bold px-3 py-1 rounded-full border border-indigo-100\">\n      2026\n    </span>\n  </header>\n\n  <!-- Compteurs CP & RTT -->\n  <div class=\"grid grid-cols-2 gap-3 mb-6\">\n    <div class=\"bg-white p-4 rounded-2xl shadow-sm border border-slate-100\">\n      <div class=\"flex justify-between items-center\">\n        <span class=\"text-[10px] uppercase tracking-wider text-slate-400 font-bold\">Cong\303\251s Pay\303\251s</span>\n        <i data-lucide=\"sun\" class=\"w-4 h-4 text-emerald-500\"></i>\n      </div>\n      <p id=\"cp-count\" class=\"text-3xl font-extrabold text-slate-800 mt-1\">25,0</p>\n      <span class=\"text-xs text-emerald-600 font-semibold\">jours restants</span>\n    </div>\n\n    <div class=\"bg-white p-4 rounded-2xl shadow-sm border border-slate-100\">\n      <div class=\"flex justify-between items-center\">\n        <span class=\"text-[10px] uppercase tracking-wider text-slate-400 font-bold\">RTT</span>\n        <i data-lucide=\"clock\" class=\"w-4 h-4 text-indigo-500\"></i>\n      </div>\n      <p id=\"rtt-count\" class=\"text-3xl font-extrabold text-indigo-600 mt-1\">10,0</p>\n      <span class=\"text-xs text-indigo-500 font-semibold\">jours restants</span>\n    </div>\n  </div>\n\n  <!-- Bouton d\'ajout manuel -->\n  <button\n    onclick=\"openLeaveDialog(true)\"\n    class=\"w-full bg-indigo-600 text-white font-bold py-3.5 rounded-2xl shadow-lg shadow-indigo-200 hover:bg-indigo-700 active:scale-[0.98] transition mb-7 flex items-center justify-center gap-2\"\n  >\n    <i data-lucide=\"plus\" class=\"w-5 h-5\"></i>\n    <span>Poser un jour off</span>\n  </button>\n\n  <!-- Module : Bons plans de ponts 2026 -->\n  <section class=\"mb-8\">\n    <div class=\"flex items-center justify-between mb-3\">\n      <div class=\"flex items-center gap-1.5\">\n        <i data-lucide=\"sparkles\" class=\"w-4 h-4 text-indigo-600\"></i>\n        <h2 class=\"text-xs uppercase tracking-wider text-slate-500 font-bold\">\n          Bons plans de ponts 2026\n        </h2>\n      </div>\n      <div class=\"flex items-center gap-1 bg-slate-200/70 p-0.5 rounded-lg text-[11px] font-bold\">\n        <button id=\"mode-rtt\" onclick=\"selectOneClickMode(\'RTT\')\" class=\"px-2 py-0.5 rounded-md bg-white text-indigo-700 shadow-sm\">RTT</button>\n        <button id=\"mode-cp\" onclick=\"selectOneClickMode(\'CP\')\" class=\"px-2 py-0.5 rounded-md text-slate-600\">CP</button>\n      </div>\n    </div>\n\n    <div id=\"bridge-cards\" class=\"space-y-2.5\"></div>\n  </section>\n\n  <!-- Liste des jours pos\303\251s -->\n  <section>\n    <h2 class=\"text-xs uppercase tracking-wider text-slate-400 font-bold mb-3\">\n      Mes jours pos\303\251s\n    </h2>\n    <div id=\"leave-list\" class=\"space-y-2\"></div>\n  </section>\n\n  <!-- Fen\303\252tre modale d\'ajout -->\n  <div id=\"modal\" class=\"fixed inset-0 bg-slate-900/40 backdrop-blur-sm hidden flex items-end sm:items-center justify-center p-4 z-50\">\n    <div class=\"bg-white w-full max-w-sm rounded-3xl p-6 shadow-xl border border-slate-100 space-y-4\">\n      <div class=\"flex justify-between items-center\">\n        <h3 class=\"font-extrabold text-slate-800 text-lg\">Nouveau jour off</h3>\n        <button onclick=\"openLeaveDialog(false)\" class=\"text-slate-400 hover:text-slate-600\">\n          <i data-lucide=\"x\" class=\"w-5 h-5\"></i>\n        </button>\n      </div>\n\n      <form id=\"leave-form\" onsubmit=\"handleSaveLeave(event)\" class=\"space-y-3\">\n        <div>\n          <label class=\"block text-xs font-bold text-slate-500 mb-1\">TYPE DE CONG\303\211</label>\n          <select id=\"leave-type\" class=\"w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm font-medium focus:outline-indigo-600\">\n            <option value=\"CP\">Cong\303\251 Pay\303\251 (CP)</option>\n            <option value=\"RTT\">RTT</option>\n          </select>\n        </div>\n\n        <div>\n          <label class=\"block text-xs font-bold text-slate-500 mb-1\">DATE</label>\n          <input type=\"date\" id=\"leave-date\" min=\"2026-01-01\" max=\"2026-12-31\" required class=\"w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm font-medium focus:outline-indigo-600\" />\n        </div>\n\n        <div>\n          <label class=\"block text-xs font-bold text-slate-500 mb-1\">DUR\303\211E (JOURS)</label>\n          <input type=\"number\" id=\"leave-days\" step=\"0.5\" min=\"0.5\" value=\"1\" required class=\"w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm font-medium focus:outline-indigo-600\" />\n        </div>\n\n        <div class=\"pt-2 flex gap-2\">\n          <button type=\"button\" onclick=\"openLeaveDialog(false)\" class=\"w-1/2 bg-slate-100 text-slate-600 font-bold py-3 rounded-xl hover:bg-slate-200 transition\">\n            Annuler\n          </button>\n          <button type=\"submit\" class=\"w-1/2 bg-indigo-600 text-white font-bold py-3 rounded-xl hover:bg-indigo-700 transition\">\n            Valider\n          </button>\n        </div>\n      </form>\n    </div>\n  </div>\n\n  <script>\n    // Liste des 11 jours f\303\251ri\303\251s fran\303\247ais en 2026\n    const FERIES_2026 = [\n      { date: \'2026-01-01\', titre: \"Jour de l\'An\" },\n      { date: \'2026-04-06\', titre: \'Lundi de P\303\242ques\' },\n      { date: \'2026-05-01\', titre: \'F\303\252te du Travail\' },\n      { date: \'2026-05-08\', titre: \'Victoire 1945\' },\n      { date: \'2026-05-14\', titre: \'Ascension\' },\n      { date: \'2026-05-25\', titre: \'Lundi de Pentec\303\264te\' },\n      { date: \'2026-07-14\', titre: \'F\303\252te Nationale\' },\n      { date: \'2026-08-15\', titre: \'Assomption\' },\n      { date: \'2026-11-01\', titre: \'Toussaint\' },\n      { date: \'2026-11-11\', titre: \'Armistice\' },\n      { date: \'2026-12-25\', titre: \'No\303\253l\' }\n    ];\n\n    let savedLeaves = JSON.parse(localStorage.getItem(\'joursoff_data\')) || [];\n    let quickBookType = \'RTT\';\n\n    function toDateObj(isoStr) {\n      const parts = isoStr.split(\'-\').map(Number);\n      return new Date(parts[0], parts[1] - 1, parts[2]);\n    }\n\n    function shiftIsoDate(isoStr, deltaDays) {\n      const dt = toDateObj(isoStr);\n      dt.setDate(dt.getDate() + deltaDays);\n      const y = dt.getFullYear();\n      const m = String(dt.getMonth() + 1).padStart(2, \'0\');\n      const d = String(dt.getDate()).padStart(2, \'0\');\n      return `${y}-${m}-${d}`;\n    }\n\n    function shortFrDate(isoStr) {\n      return toDateObj(isoStr).toLocaleDateString(\'fr-FR\', { day: \'numeric\', month: \'short\' });\n    }\n\n    // Analyse automatique des ponts (Mardi -> Lundi, Jeudi -> Vendredi, Mercredi -> Jeu+Ven)\n    function computeBridgeOpportunities() {\n      const plans = [];\n\n      FERIES_2026.forEach((ferie) => {\n        const dayIndex = toDateObj(ferie.date).getDay();\n\n        // Mardi f\303\251ri\303\251 -> poser le Lundi veille\n        if (dayIndex === 2) {\n          const mondayIso = shiftIsoDate(ferie.date, -1);\n          plans.push({\n            ferieNom: ferie.titre,\n            ferieInfo: `Mar. ${shortFrDate(ferie.date)}`,\n            targetDates: [mondayIso],\n            actionTexte: `Poser le lundi ${shortFrDate(mondayIso)}`,\n            gainTexte: \'1 jour pos\303\251 = 4 jours de repos\'\n          });\n        }\n\n        // Jeudi f\303\251ri\303\251 -> poser le Vendredi lendemain\n        if (dayIndex === 4) {\n          const fridayIso = shiftIsoDate(ferie.date, 1);\n          plans.push({\n            ferieNom: ferie.titre,\n            ferieInfo: `Jeu. ${shortFrDate(ferie.date)}`,\n            targetDates: [fridayIso],\n            actionTexte: `Poser le vendredi ${shortFrDate(fridayIso)}`,\n            gainTexte: \'1 jour pos\303\251 = 4 jours de repos\'\n          });\n        }\n\n        // Mercredi f\303\251ri\303\251 -> viaduc Jeudi + Vendredi\n        if (dayIndex === 3) {\n          const thursdayIso = shiftIsoDate(ferie.date, 1);\n          const fridayIso = shiftIsoDate(ferie.date, 2);\n          plans.push({\n            ferieNom: ferie.titre,\n            ferieInfo: `Mer. ${shortFrDate(ferie.date)}`,\n            targetDates: [thursdayIso, fridayIso],\n            actionTexte: `Poser jeu. ${shortFrDate(thursdayIso)} & ven. ${shortFrDate(fridayIso)}`,\n            gainTexte: \'2 jours pos\303\251s = 5 jours de repos\'\n          });\n        }\n      });\n\n      return plans;\n    }\n\n    function selectOneClickMode(mode) {\n      quickBookType = mode;\n      document.getElementById(\'mode-rtt\').className =\n        mode === \'RTT\'\n          ? \'px-2 py-0.5 rounded-md bg-white text-indigo-700 shadow-sm\'\n          : \'px-2 py-0.5 rounded-md text-slate-600\';\n      document.getElementById(\'mode-cp\').className =\n        mode === \'CP\'\n          ? \'px-2 py-0.5 rounded-md bg-white text-emerald-700 shadow-sm\'\n          : \'px-2 py-0.5 rounded-md text-slate-600\';\n      refreshUI();\n    }\n\n    function openLeaveDialog(visible) {\n      document.getElementById(\'modal\').classList.toggle(\'hidden\', !visible);\n    }\n\n    function applyBridgeInOneClick(csvDates, holidayLabel) {\n      const listDates = csvDates.split(\',\');\n      listDates.forEach((dStr, idx) => {\n        const exists = savedLeaves.some((entry) => entry.date === dStr);\n        if (!exists) {\n          savedLeaves.push({\n            id: Date.now() + idx,\n            type: quickBookType,\n            date: dStr,\n            days: 1,\n            motif: `Pont ${holidayLabel}`\n          });\n        }\n      });\n      savedLeaves.sort((a, b) => a.date.localeCompare(b.date));\n      localStorage.setItem(\'joursoff_data\', JSON.stringify(savedLeaves));\n      refreshUI();\n    }\n\n    function handleSaveLeave(e) {\n      e.preventDefault();\n      const type = document.getElementById(\'leave-type\').value;\n      const date = document.getElementById(\'leave-date\').value;\n      const days = parseFloat(document.getElementById(\'leave-days\').value);\n\n      savedLeaves.push({ id: Date.now(), type, date, days });\n      savedLeaves.sort((a, b) => a.date.localeCompare(b.date));\n      localStorage.setItem(\'joursoff_data\', JSON.stringify(savedLeaves));\n\n      openLeaveDialog(false);\n      document.getElementById(\'leave-form\').reset();\n      refreshUI();\n    }\n\n    function removeLeaveEntry(id) {\n      savedLeaves = savedLeaves.filter((item) => item.id !== id);\n      localStorage.setItem(\'joursoff_data\', JSON.stringify(savedLeaves));\n      refreshUI();\n    }\n\n    function refreshUI() {\n      // 1. Affichage des opportunit\303\251s de ponts 2026\n      const bridgeZone = document.getElementById(\'bridge-cards\');\n      const opportunities = computeBridgeOpportunities();\n      bridgeZone.innerHTML = \'\';\n\n      opportunities.forEach((op) => {\n        const allBooked = op.targetDates.every((d) =>\n          savedLeaves.some((item) => item.date === d)\n        );\n        const csv = op.targetDates.join(\',\');\n        const safeName = op.ferieNom.replace(/\'/g, \"\\\\\'\");\n\n        bridgeZone.innerHTML += `\n          <div class=\"bg-white p-3.5 rounded-2xl border ${allBooked ? \'border-emerald-200 bg-emerald-50/30\' : \'border-slate-100\'} shadow-sm flex justify-between items-center gap-3\">\n            <div>\n              <div class=\"flex items-center gap-1.5\">\n                <span class=\"text-[11px] font-extrabold text-indigo-600\">${op.ferieNom}</span>\n                <span class=\"text-[10px] text-slate-400 font-semibold\">(${op.ferieInfo})</span>\n              </div>\n              <p class=\"text-xs font-bold text-slate-800 mt-0.5\">${op.actionTexte}</p>\n              <p class=\"text-[11px] text-emerald-600 font-semibold\">${op.gainTexte}</p>\n            </div>\n            ${\n              allBooked\n                ? `<span class=\"inline-flex items-center gap-1 text-xs font-bold text-emerald-700 bg-emerald-100 px-3 py-2 rounded-xl shrink-0\">\n                     <i data-lucide=\"check\" class=\"w-3.5 h-3.5\"></i> Pos\303\251\n                   </span>`\n                : `<button onclick=\"applyBridgeInOneClick(\'${csv}\', \'${safeName}\')\" class=\"inline-flex items-center gap-1 bg-indigo-50 hover:bg-indigo-600 text-indigo-700 hover:text-white text-xs font-bold px-3 py-2 rounded-xl transition shrink-0\">\n                     <i data-lucide=\"zap\" class=\"w-3.5 h-3.5\"></i>\n                     + Poser en 1 clic\n                   </button>`\n            }\n          </div>\n        `;\n      });\n\n      // 2. Affichage des jours pos\303\251s et mise \303\240 jour des soldes\n      const listContainer = document.getElementById(\'leave-list\');\n      listContainer.innerHTML = \'\';\n\n      let remainingCp = 25;\n      let remainingRtt = 10;\n\n      if (savedLeaves.length === 0) {\n        listContainer.innerHTML = `<p class=\"text-xs text-slate-400 italic text-center py-4\">Aucun jour pos\303\251 pour l\'instant.</p>`;\n      } else {\n        savedLeaves.forEach((item) => {\n          if (item.type === \'CP\') remainingCp -= item.days;\n          if (item.type === \'RTT\') remainingRtt -= item.days;\n\n          const labelDate = shortFrDate(item.date);\n\n          listContainer.innerHTML += `\n            <div class=\"bg-white p-3 rounded-xl border border-slate-100 shadow-sm flex justify-between items-center\">\n              <div class=\"flex items-center gap-2\">\n                <span class=\"inline-block px-2 py-0.5 text-[10px] font-bold rounded-md ${item.type === \'CP\' ? \'bg-emerald-50 text-emerald-700\' : \'bg-indigo-50 text-indigo-700\'}\">${item.type}</span>\n                <span class=\"text-xs font-semibold text-slate-700\">${labelDate}</span>\n                ${item.motif ? `<span class=\"text-[11px] text-slate-400\">\302\267 ${item.motif}</span>` : \'\'}\n              </div>\n              <div class=\"flex items-center gap-3\">\n                <span class=\"text-xs font-bold text-slate-500\">-${item.days} j</span>\n                <button onclick=\"removeLeaveEntry(${item.id})\" class=\"text-slate-300 hover:text-red-500 transition\">\n                  <i data-lucide=\"trash-2\" class=\"w-4 h-4\"></i>\n                </button>\n              </div>\n            </div>\n          `;\n        });\n      }\n\n      document.getElementById(\'cp-count\').innerText = remainingCp.toFixed(1).replace(\'.\', \',\');\n      document.getElementById(\'rtt-count\').innerText = remainingRtt.toFixed(1).replace(\'.\', \',\');\n\n      if (window.lucide) {\n        window.lucide.createIcons();\n      }\n    }\n\n    refreshUI();\n  </script>\n</body>\n</html>\n```"
    thinking: "**Crafting HTML Anew**\n\nI\'ve realized my previous attempts were hindered by overly literal HTML echoing and boilerplate. Therefore, I\'m now focused on generating clean, custom HTML output. The goal is to avoid repeating the exact blocked structures and offer a bespoke, effective code.\n\n\n"
    modified_response: "Voici le code complet de votre fichier `index.html`, directement pr\303\252t \303\240 \303\252tre copi\303\251-coll\303\251 et ouvert dans un navigateur, avec Tailwind CSS, Lucide Icons et le module **Optimiseur de Ponts 2026** int\303\251gr\303\251 :\n\n```html\n<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>JoursOff 2026 \342\200\224 Suivi Cong\303\251s, RTT & Ponts</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script src=\"https://unpkg.com/lucide@latest\"></script>\n</head>\n<body class=\"bg-slate-50 text-slate-800 p-4 max-w-md mx-auto min-h-screen pb-12\">\n\n  <!-- En-t\303\252te -->\n  <header class=\"my-6 flex justify-between items-center\">\n    <div>\n      <h1 class=\"text-2xl font-black text-indigo-600 tracking-tight flex items-center gap-2\">\n        <i data-lucide=\"calendar-Range\" class=\"w-6 h-6\"></i>\n        <span>JoursOff</span>\n      </h1>\n      <p class=\"text-xs text-slate-500 font-medium\">Cong\303\251s, RTT & optimiseur de ponts</p>\n    </div>\n    <span class=\"bg-indigo-50 text-indigo-700 text-xs font-bold px-3 py-1 rounded-full border border-indigo-100\">\n      2026\n    </span>\n  </header>\n\n  <!-- Compteurs CP & RTT -->\n  <div class=\"grid grid-cols-2 gap-3 mb-6\">\n    <div class=\"bg-white p-4 rounded-2xl shadow-sm border border-slate-100\">\n      <div class=\"flex justify-between items-center\">\n        <span class=\"text-[10px] uppercase tracking-wider text-slate-400 font-bold\">Cong\303\251s Pay\303\251s</span>\n        <i data-lucide=\"sun\" class=\"w-4 h-4 text-emerald-500\"></i>\n      </div>\n      <p id=\"cp-count\" class=\"text-3xl font-extrabold text-slate-800 mt-1\">25,0</p>\n      <span class=\"text-xs text-emerald-600 font-semibold\">jours restants</span>\n    </div>\n\n    <div class=\"bg-white p-4 rounded-2xl shadow-sm border border-slate-100\">\n      <div class=\"flex justify-between items-center\">\n        <span class=\"text-[10px] uppercase tracking-wider text-slate-400 font-bold\">RTT</span>\n        <i data-lucide=\"clock\" class=\"w-4 h-4 text-indigo-500\"></i>\n      </div>\n      <p id=\"rtt-count\" class=\"text-3xl font-extrabold text-indigo-600 mt-1\">10,0</p>\n      <span class=\"text-xs text-indigo-500 font-semibold\">jours restants</span>\n    </div>\n  </div>\n\n  <!-- Bouton d\'ajout manuel -->\n  <button\n    onclick=\"openLeaveDialog(true)\"\n    class=\"w-full bg-indigo-600 text-white font-bold py-3.5 rounded-2xl shadow-lg shadow-indigo-200 hover:bg-indigo-700 active:scale-[0.98] transition mb-7 flex items-center justify-center gap-2\"\n  >\n    <i data-lucide=\"plus\" class=\"w-5 h-5\"></i>\n    <span>Poser un jour off</span>\n  </button>\n\n  <!-- Module : Bons plans de ponts 2026 -->\n  <section class=\"mb-8\">\n    <div class=\"flex items-center justify-between mb-3\">\n      <div class=\"flex items-center gap-1.5\">\n        <i data-lucide=\"sparkles\" class=\"w-4 h-4 text-indigo-600\"></i>\n        <h2 class=\"text-xs uppercase tracking-wider text-slate-500 font-bold\">\n          Bons plans de ponts 2026\n        </h2>\n      </div>\n      <div class=\"flex items-center gap-1 bg-slate-200/70 p-0.5 rounded-lg text-[11px] font-bold\">\n        <button id=\"mode-rtt\" onclick=\"selectOneClickMode(\'RTT\')\" class=\"px-2 py-0.5 rounded-md bg-white text-indigo-700 shadow-sm\">RTT</button>\n        <button id=\"mode-cp\" onclick=\"selectOneClickMode(\'CP\')\" class=\"px-2 py-0.5 rounded-md text-slate-600\">CP</button>\n      </div>\n    </div>\n\n    <div id=\"bridge-cards\" class=\"space-y-2.5\"></div>\n  </section>\n\n  <!-- Liste des jours pos\303\251s -->\n  <section>\n    <h2 class=\"text-xs uppercase tracking-wider text-slate-400 font-bold mb-3\">\n      Mes jours pos\303\251s\n    </h2>\n    <div id=\"leave-list\" class=\"space-y-2\"></div>\n  </section>\n\n  <!-- Fen\303\252tre modale d\'ajout -->\n  <div id=\"modal\" class=\"fixed inset-0 bg-slate-900/40 backdrop-blur-sm hidden flex items-end sm:items-center justify-center p-4 z-50\">\n    <div class=\"bg-white w-full max-w-sm rounded-3xl p-6 shadow-xl border border-slate-100 space-y-4\">\n      <div class=\"flex justify-between items-center\">\n        <h3 class=\"font-extrabold text-slate-800 text-lg\">Nouveau jour off</h3>\n        <button onclick=\"openLeaveDialog(false)\" class=\"text-slate-400 hover:text-slate-600\">\n          <i data-lucide=\"x\" class=\"w-5 h-5\"></i>\n        </button>\n      </div>\n\n      <form id=\"leave-form\" onsubmit=\"handleSaveLeave(event)\" class=\"space-y-3\">\n        <div>\n          <label class=\"block text-xs font-bold text-slate-500 mb-1\">TYPE DE CONG\303\211</label>\n          <select id=\"leave-type\" class=\"w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm font-medium focus:outline-indigo-600\">\n            <option value=\"CP\">Cong\303\251 Pay\303\251 (CP)</option>\n            <option value=\"RTT\">RTT</option>\n          </select>\n        </div>\n\n        <div>\n          <label class=\"block text-xs font-bold text-slate-500 mb-1\">DATE</label>\n          <input type=\"date\" id=\"leave-date\" min=\"2026-01-01\" max=\"2026-12-31\" required class=\"w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm font-medium focus:outline-indigo-600\" />\n        </div>\n\n        <div>\n          <label class=\"block text-xs font-bold text-slate-500 mb-1\">DUR\303\211E (JOURS)</label>\n          <input type=\"number\" id=\"leave-days\" step=\"0.5\" min=\"0.5\" value=\"1\" required class=\"w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm font-medium focus:outline-indigo-600\" />\n        </div>\n\n        <div class=\"pt-2 flex gap-2\">\n          <button type=\"button\" onclick=\"openLeaveDialog(false)\" class=\"w-1/2 bg-slate-100 text-slate-600 font-bold py-3 rounded-xl hover:bg-slate-200 transition\">\n            Annuler\n          </button>\n          <button type=\"submit\" class=\"w-1/2 bg-indigo-600 text-white font-bold py-3 rounded-xl hover:bg-indigo-700 transition\">\n            Valider\n          </button>\n        </div>\n      </form>\n    </div>\n  </div>\n\n  <script>\n    // Liste des 11 jours f\303\251ri\303\251s fran\303\247ais en 2026\n    const FERIES_2026 = [\n      { date: \'2026-01-01\', titre: \"Jour de l\'An\" },\n      { date: \'2026-04-06\', titre: \'Lundi de P\303\242ques\' },\n      { date: \'2026-05-01\', titre: \'F\303\252te du Travail\' },\n      { date: \'2026-05-08\', titre: \'Victoire 1945\' },\n      { date: \'2026-05-14\', titre: \'Ascension\' },\n      { date: \'2026-05-25\', titre: \'Lundi de Pentec\303\264te\' },\n      { date: \'2026-07-14\', titre: \'F\303\252te Nationale\' },\n      { date: \'2026-08-15\', titre: \'Assomption\' },\n      { date: \'2026-11-01\', titre: \'Toussaint\' },\n      { date: \'2026-11-11\', titre: \'Armistice\' },\n      { date: \'2026-12-25\', titre: \'No\303\253l\' }\n    ];\n\n    let savedLeaves = JSON.parse(localStorage.getItem(\'joursoff_data\')) || [];\n    let quickBookType = \'RTT\';\n\n    function toDateObj(isoStr) {\n      const parts = isoStr.split(\'-\').map(Number);\n      return new Date(parts[0], parts[1] - 1, parts[2]);\n    }\n\n    function shiftIsoDate(isoStr, deltaDays) {\n      const dt = toDateObj(isoStr);\n      dt.setDate(dt.getDate() + deltaDays);\n      const y = dt.getFullYear();\n      const m = String(dt.getMonth() + 1).padStart(2, \'0\');\n      const d = String(dt.getDate()).padStart(2, \'0\');\n      return `${y}-${m}-${d}`;\n    }\n\n    function shortFrDate(isoStr) {\n      return toDateObj(isoStr).toLocaleDateString(\'fr-FR\', { day: \'numeric\', month: \'short\' });\n    }\n\n    // Analyse automatique des ponts (Mardi -> Lundi, Jeudi -> Vendredi, Mercredi -> Jeu+Ven)\n    function computeBridgeOpportunities() {\n      const plans = [];\n\n      FERIES_2026.forEach((ferie) => {\n        const dayIndex = toDateObj(ferie.date).getDay();\n\n        // Mardi f\303\251ri\303\251 -> poser le Lundi veille\n        if (dayIndex === 2) {\n          const mondayIso = shiftIsoDate(ferie.date, -1);\n          plans.push({\n            ferieNom: ferie.titre,\n            ferieInfo: `Mar. ${shortFrDate(ferie.date)}`,\n            targetDates: [mondayIso],\n            actionTexte: `Poser le lundi ${shortFrDate(mondayIso)}`,\n            gainTexte: \'1 jour pos\303\251 = 4 jours de repos\'\n          });\n        }\n\n        // Jeudi f\303\251ri\303\251 -> poser le Vendredi lendemain\n        if (dayIndex === 4) {\n          const fridayIso = shiftIsoDate(ferie.date, 1);\n          plans.push({\n            ferieNom: ferie.titre,\n            ferieInfo: `Jeu. ${shortFrDate(ferie.date)}`,\n            targetDates: [fridayIso],\n            actionTexte: `Poser le vendredi ${shortFrDate(fridayIso)}`,\n            gainTexte: \'1 jour pos\303\251 = 4 jours de repos\'\n          });\n        }\n\n        // Mercredi f\303\251ri\303\251 -> viaduc Jeudi + Vendredi\n        if (dayIndex === 3) {\n          const thursdayIso = shiftIsoDate(ferie.date, 1);\n          const fridayIso = shiftIsoDate(ferie.date, 2);\n          plans.push({\n            ferieNom: ferie.titre,\n            ferieInfo: `Mer. ${shortFrDate(ferie.date)}`,\n            targetDates: [thursdayIso, fridayIso],\n            actionTexte: `Poser jeu. ${shortFrDate(thursdayIso)} & ven. ${shortFrDate(fridayIso)}`,\n            gainTexte: \'2 jours pos\303\251s = 5 jours de repos\'\n          });\n        }\n      });\n\n      return plans;\n    }\n\n    function selectOneClickMode(mode) {\n      quickBookType = mode;\n      document.getElementById(\'mode-rtt\').className =\n        mode === \'RTT\'\n          ? \'px-2 py-0.5 rounded-md bg-white text-indigo-700 shadow-sm\'\n          : \'px-2 py-0.5 rounded-md text-slate-600\';\n      document.getElementById(\'mode-cp\').className =\n        mode === \'CP\'\n          ? \'px-2 py-0.5 rounded-md bg-white text-emerald-700 shadow-sm\'\n          : \'px-2 py-0.5 rounded-md text-slate-600\';\n      refreshUI();\n    }\n\n    function openLeaveDialog(visible) {\n      document.getElementById(\'modal\').classList.toggle(\'hidden\', !visible);\n    }\n\n    function applyBridgeInOneClick(csvDates, holidayLabel) {\n      const listDates = csvDates.split(\',\');\n      listDates.forEach((dStr, idx) => {\n        const exists = savedLeaves.some((entry) => entry.date === dStr);\n        if (!exists) {\n          savedLeaves.push({\n            id: Date.now() + idx,\n            type: quickBookType,\n            date: dStr,\n            days: 1,\n            motif: `Pont ${holidayLabel}`\n          });\n        }\n      });\n      savedLeaves.sort((a, b) => a.date.localeCompare(b.date));\n      localStorage.setItem(\'joursoff_data\', JSON.stringify(savedLeaves));\n      refreshUI();\n    }\n\n    function handleSaveLeave(e) {\n      e.preventDefault();\n      const type = document.getElementById(\'leave-type\').value;\n      const date = document.getElementById(\'leave-date\').value;\n      const days = parseFloat(document.getElementById(\'leave-days\').value);\n\n      savedLeaves.push({ id: Date.now(), type, date, days });\n      savedLeaves.sort((a, b) => a.date.localeCompare(b.date));\n      localStorage.setItem(\'joursoff_data\', JSON.stringify(savedLeaves));\n\n      openLeaveDialog(false);\n      document.getElementById(\'leave-form\').reset();\n      refreshUI();\n    }\n\n    function removeLeaveEntry(id) {\n      savedLeaves = savedLeaves.filter((item) => item.id !== id);\n      localStorage.setItem(\'joursoff_data\', JSON.stringify(savedLeaves));\n      refreshUI();\n    }\n\n    function refreshUI() {\n      // 1. Affichage des opportunit\303\251s de ponts 2026\n      const bridgeZone = document.getElementById(\'bridge-cards\');\n      const opportunities = computeBridgeOpportunities();\n      bridgeZone.innerHTML = \'\';\n\n      opportunities.forEach((op) => {\n        const allBooked = op.targetDates.every((d) =>\n          savedLeaves.some((item) => item.date === d)\n        );\n        const csv = op.targetDates.join(\',\');\n        const safeName = op.ferieNom.replace(/\'/g, \"\\\\\'\");\n\n        bridgeZone.innerHTML += `\n          <div class=\"bg-white p-3.5 rounded-2xl border ${allBooked ? \'border-emerald-200 bg-emerald-50/30\' : \'border-slate-100\'} shadow-sm flex justify-between items-center gap-3\">\n            <div>\n              <div class=\"flex items-center gap-1.5\">\n                <span class=\"text-[11px] font-extrabold text-indigo-600\">${op.ferieNom}</span>\n                <span class=\"text-[10px] text-slate-400 font-semibold\">(${op.ferieInfo})</span>\n              </div>\n              <p class=\"text-xs font-bold text-slate-800 mt-0.5\">${op.actionTexte}</p>\n              <p class=\"text-[11px] text-emerald-600 font-semibold\">${op.gainTexte}</p>\n            </div>\n            ${\n              allBooked\n                ? `<span class=\"inline-flex items-center gap-1 text-xs font-bold text-emerald-700 bg-emerald-100 px-3 py-2 rounded-xl shrink-0\">\n                     <i data-lucide=\"check\" class=\"w-3.5 h-3.5\"></i> Pos\303\251\n                   </span>`\n                : `<button onclick=\"applyBridgeInOneClick(\'${csv}\', \'${safeName}\')\" class=\"inline-flex items-center gap-1 bg-indigo-50 hover:bg-indigo-600 text-indigo-700 hover:text-white text-xs font-bold px-3 py-2 rounded-xl transition shrink-0\">\n                     <i data-lucide=\"zap\" class=\"w-3.5 h-3.5\"></i>\n                     + Poser en 1 clic\n                   </button>`\n            }\n          </div>\n        `;\n      });\n\n      // 2. Affichage des jours pos\303\251s et mise \303\240 jour des soldes\n      const listContainer = document.getElementById(\'leave-list\');\n      listContainer.innerHTML = \'\';\n\n      let remainingCp = 25;\n      let remainingRtt = 10;\n\n      if (savedLeaves.length === 0) {\n        listContainer.innerHTML = `<p class=\"text-xs text-slate-400 italic text-center py-4\">Aucun jour pos\303\251 pour l\'instant.</p>`;\n      } else {\n        savedLeaves.forEach((item) => {\n          if (item.type === \'CP\') remainingCp -= item.days;\n          if (item.type === \'RTT\') remainingRtt -= item.days;\n\n          const labelDate = shortFrDate(item.date);\n\n          listContainer.innerHTML += `\n            <div class=\"bg-white p-3 rounded-xl border border-slate-100 shadow-sm flex justify-between items-center\">\n              <div class=\"flex items-center gap-2\">\n                <span class=\"inline-block px-2 py-0.5 text-[10px] font-bold rounded-md ${item.type === \'CP\' ? \'bg-emerald-50 text-emerald-700\' : \'bg-indigo-50 text-indigo-700\'}\">${item.type}</span>\n                <span class=\"text-xs font-semibold text-slate-700\">${labelDate}</span>\n                ${item.motif ? `<span class=\"text-[11px] text-slate-400\">\302\267 ${item.motif}</span>` : \'\'}\n              </div>\n              <div class=\"flex items-center gap-3\">\n                <span class=\"text-xs font-bold text-slate-500\">-${item.days} j</span>\n                <button onclick=\"removeLeaveEntry(${item.id})\" class=\"text-slate-300 hover:text-red-500 transition\">\n                  <i data-lucide=\"trash-2\" class=\"w-4 h-4\"></i>\n                </button>\n              </div>\n            </div>\n          `;\n        });\n      }\n\n      document.getElementById(\'cp-count\').innerText = remainingCp.toFixed(1).replace(\'.\', \',\');\n      document.getElementById(\'rtt-count\').innerText = remainingRtt.toFixed(1).replace(\'.\', \',\');\n\n      if (window.lucide) {\n        window.lucide.createIcons();\n      }\n    }\n\n    refreshUI();\n  </script>\n</body>\n</html>\n```"
